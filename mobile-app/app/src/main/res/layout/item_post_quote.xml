<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/outline_variant_10"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER: Avatar, Tên, Thời gian, Nút More -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_author_avatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                tools:src="@drawable/profile_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_author_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Duc Loi" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_post_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp"
                    tools:text="2h ago" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_post_more"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more_horiz"
                app:tint="@color/on_surface_variant" />
        </LinearLayout>

        <!-- QUOTE CONTAINER -->
        <FrameLayout
            android:id="@+id/layout_quote_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_light_brown"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <!-- " -->
            <ImageView
                android:id="@+id/img_quote_watermark"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:alpha="0.16"
                android:src="@drawable/ic_format_quote"
                app:tint="@color/primary" />

            <!-- Nội dung chữ trích dẫn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Câu trích dẫn -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_quote_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp"
                    android:textStyle="italic"
                    tools:text="“The greatest enemy of knowledge is not ignorance, it is the illusion of knowledge.”" />

                <!-- Nguồn sách / Tác giả -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_quote_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="— Stephen Hawking, Page 42" />
            </LinearLayout>
        </FrameLayout>

        <!-- ĐƯỜNG KẺ NGANG MỜ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/outline_variant_10" />

        <!-- ACTION BAR (Like, Comment, Bookmark, Share) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Like -->
            <ImageView
                android:id="@+id/btn_like"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_favorite"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/tv_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                tools:text="48" />

            <!-- Comment -->
            <ImageView
                android:id="@+id/btn_comment"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_comment"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/tv_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                tools:text="12" />

            <!-- Khoảng giãn đẩy Bookmark và Share sang phải -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Bookmark / Save -->
            <ImageView
                android:id="@+id/btn_bookmark"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_bookmark"
                app:tint="@color/on_surface_variant" />

            <!-- Share -->
            <ImageView
                android:id="@+id/btn_share"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                app:tint="@color/on_surface_variant" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
