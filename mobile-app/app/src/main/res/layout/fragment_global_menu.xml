<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface"
    android:clickable="true"
    android:focusable="true">

    <!-- Header -->
    <include layout="@layout/layout_menu_header" />
    
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline_variant"
        android:alpha="0.3" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Messages -->
            <TextView
                android:id="@+id/btnMenuMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_message"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tertiary"
                android:padding="12dp"
                android:drawablePadding="16dp"
                app:drawableStartCompat="@drawable/ic_menu_message"
                app:drawableTint="@color/primary"
                android:background="@drawable/bg_menu_item_ripple"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical" />

            <!-- Friends -->
            <TextView
                android:id="@+id/btnMenuFriends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_friends"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tertiary"
                android:padding="12dp"
                android:drawablePadding="16dp"
                app:drawableStartCompat="@drawable/ic_menu_friends"
                app:drawableTint="@color/primary"
                android:background="@drawable/bg_menu_item_ripple"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical" />

            <!-- Groups -->
            <TextView
                android:id="@+id/btnMenuGroups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_groups"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tertiary"
                android:padding="12dp"
                android:drawablePadding="16dp"
                app:drawableStartCompat="@drawable/ic_menu_groups"
                app:drawableTint="@color/primary"
                android:background="@drawable/bg_menu_item_ripple"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline_variant"
                android:alpha="0.3"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- Account Settings -->
            <TextView
                android:id="@+id/btnMenuSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_account_settings"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tertiary"
                android:padding="12dp"
                android:drawablePadding="16dp"
                app:drawableStartCompat="@drawable/ic_menu_settings"
                app:drawableTint="@color/primary"
                android:background="@drawable/bg_menu_item_ripple"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical" />

            <!-- Logout -->
            <TextView
                android:id="@+id/btnMenuLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_logout"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/error"
                android:padding="12dp"
                android:drawablePadding="16dp"
                app:drawableStartCompat="@drawable/ic_menu_logout"
                app:drawableTint="@color/error"
                android:background="@drawable/bg_menu_logout_ripple"
                android:gravity="center_vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
