<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <!-- Avatar -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_person"
        app:strokeWidth="1dp"
        app:strokeColor="@color/outline_variant_30"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tail -->
    <ImageView
        android:id="@+id/ivTail"
        android:layout_width="8dp"
        android:layout_height="12dp"
        android:src="@drawable/ic_chat_tail_right"
        app:tint="@color/primary"
        app:layout_constraintTop_toTopOf="@id/bubbleLayout"
        app:layout_constraintEnd_toStartOf="@id/ivAvatar" />

    <!-- Bubble -->
    <LinearLayout
        android:id="@+id/bubbleLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chat_bubble_sent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/ivTail"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        android:layout_marginStart="80dp">

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Yes! I loved the plot twist. Should we discuss it in the group?"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/on_primary"/>

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_gravity="end"
            android:alpha="0.7"
            tools:text="10:16 AM"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/on_primary"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
