<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_post_options_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- DRAG HANDLE -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- TIÊU ĐỀ BOTTOM SHEET -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/playfair_display_bold"
        android:text="Post Options"
        android:textColor="@color/on_surface"
        android:textSize="18sp"
        android:textStyle="bold"
        app:fontFamily="@font/playfair_display_bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="4dp"
        android:background="@color/outline_variant_30" />

    <!-- 1. CHỈNH SỬA BÀI VIẾT (Hiện khi ở My Posts) -->
    <LinearLayout
        android:id="@+id/item_edit_post"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="14dp">

        <ImageView
            android:id="@+id/img_edit_post_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/on_surface_variant" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_edit_post_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Edit Post"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/divider_edit_post"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="44dp"
        android:background="@color/outline_variant_30" />

    <!-- 2. LƯU BÀI / BỎ LƯU (Hiện khi ở Feed hoặc Saved) -->
    <LinearLayout
        android:id="@+id/item_save_post"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="14dp">

        <ImageView
            android:id="@+id/img_save_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_bookmark"
            app:tint="@color/on_surface_variant" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_save_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Save Post"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/divider_save_post"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="44dp"
        android:background="@color/outline_variant_30" />

    <!-- 3. XEM BÀI VIẾT GỐC (Hiện khi ở Saved) -->
    <LinearLayout
        android:id="@+id/item_view_original"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="14dp">

        <ImageView
            android:id="@+id/img_view_original_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_open_in_new"
            app:tint="@color/on_surface_variant" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_view_original_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="View Original Post"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/divider_view_original"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="44dp"
        android:background="@color/outline_variant_30" />

    <!-- 4. SAO CHÉP NỘI DUNG / TRÍCH DẪN (Hiện khi ở Saved) -->
    <LinearLayout
        android:id="@+id/item_copy_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="14dp">

        <ImageView
            android:id="@+id/img_copy_content_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_content_copy"
            app:tint="@color/on_surface_variant" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_copy_content_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Copy Quote / Text"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/divider_copy_content"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="44dp"
        android:background="@color/outline_variant_30" />

    <!-- 5. SAO CHÉP LIÊN KẾT (Dùng chung cho cả My Posts, Saved và Feed) -->
    <LinearLayout
        android:id="@+id/item_copy_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="14dp">

        <ImageView
            android:id="@+id/img_copy_link_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_link"
            app:tint="@color/on_surface_variant" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_copy_link_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Copy Link"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/divider_copy_link"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="44dp"
        android:background="@color/outline_variant_30" />

    <!-- 6. CHIA SẺ BÀI VIẾT (Dùng chung cho cả My Posts, Saved và Feed) -->
    <LinearLayout
        android:id="@+id/item_share_post"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="14dp">

        <ImageView
            android:id="@+id/img_share_post_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_share"
            app:tint="@color/on_surface_variant" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_share_post_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Share Post"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/divider_share_post"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="44dp"
        android:background="@color/outline_variant_30" />

    <!-- 7. XÓA BÀI VIẾT (Màu đỏ cảnh báo - Chỉ hiện khi ở My Posts) -->
    <LinearLayout
        android:id="@+id/item_delete_post"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="14dp">

        <ImageView
            android:id="@+id/img_delete_post_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/error" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_delete_post_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Delete Post"
            android:textColor="@color/error"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_delete_post"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="44dp"
        android:background="@color/outline_variant_30" />

    <!-- 8. BÁO CÁO BÀI VIẾT (Màu đỏ cảnh báo - Chỉ hiện khi ở Feed / bài của người khác) -->
    <LinearLayout
        android:id="@+id/item_report_post"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="14dp">

        <ImageView
            android:id="@+id/img_report_post_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_flag_report"
            app:tint="@color/error" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_report_post_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Report Post"
            android:textColor="@color/error"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
